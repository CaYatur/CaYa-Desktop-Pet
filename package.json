{
  "name": "caya-desktop-pet-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CaYaDev temalı, sprite-sheet tabanlı Windows masaüstü pet uygulaması (Tauri + React + TypeScript).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "generate-sprites": "node scripts/generate-sprites.mjs",
    "generate-icons": "node scripts/generate-icons.mjs",
    "generate-assets": "node scripts/generate-sprites.mjs && node scripts/generate-icons.mjs",
    "postinstall": "node scripts/generate-sprites.mjs && node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-fs": "^2.0.3",
    "@tauri-apps/plugin-os": "^2.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
